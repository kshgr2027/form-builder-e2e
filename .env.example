# ─────────────────────────────────────────────────────────────────────────────
# Playwright Form Builder suite — environment
# Copy to .env and adjust for your machine.  .env is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the running Laravel app.
# `php artisan serve` defaults to http://127.0.0.1:8000
# NOTE: also set APP_URL in the Laravel .env to this same value, and APP_DEBUG=true.
BASE_URL=http://127.0.0.1:8000

# ── Database (optional but strongly recommended) ─────────────────────────────
# Used for persistence assertions and for test-data cleanup.
# If these are omitted, DB-dependent assertions are skipped (suite still runs).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=demo
DB_USERNAME=root
DB_PASSWORD=root

# ── Optional: let Playwright start/stop the Laravel app itself ────────────────
# Set to 1 to run `php artisan serve` from ../lms-assessment via config.webServer.
PW_START_APP=0
PW_APP_DIR=../lms-assessment
PW_PHP_BIN=php
