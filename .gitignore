node_modules/
/test-results/
/playwright-report/
/playwright/.cache/
/results/
/blob-report/

# local env
.env
.env.local

# generated evidence (keep curated samples under evidence/samples/)
/evidence/screenshots/*
/evidence/traces/*
!/evidence/**/.gitkeep
!/evidence/samples/**

# transient local run logs (the curated copies live under evidence/execution/)
/phase3-*.txt
/diag*.mjs

# bundled Laravel app under test (./app) — commit source only, not build/runtime state
/app/vendor/
/app/node_modules/
/app/.env
/app/.env.backup
/app/storage/framework/cache/*
/app/storage/framework/sessions/*
/app/storage/framework/views/*
/app/storage/logs/*
/app/bootstrap/cache/*
!/app/**/.gitignore
!/app/**/.gitkeep

# misc
*.log
.DS_Store
Thumbs.db
